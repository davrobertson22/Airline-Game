{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tailwindsairlinegame.com" }],
      "destination": "https://www.tailwindsairlinegame.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/tiles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    }
  ]
}
